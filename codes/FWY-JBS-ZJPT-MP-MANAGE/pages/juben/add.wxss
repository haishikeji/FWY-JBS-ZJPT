/* pages/juben/add.wxss */
.body
{
  margin: 20rpx;
  width: 710rpx;
  padding: 20rpx 0;
  box-sizing: border-box;
  background-color: #ffffff;
  border-radius: 20rpx;
  position: relative;
  height: 710rpx;
  overflow: hidden;
}
.left
{
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 70rpx;
  overflow: hidden;
  height: 690rpx;
  z-index: 7;
  background-color: #ffffff;
}
.showall
{
  width: 140rpx;
}
.lefttitle
{
  width: 70rpx;
  text-align: center;
  height: 32rpx;
  line-height: 32rpx;
}
.catescroll
{
  width: 100%;
  height: 660rpx;
  white-space: nowrap;
}
.catelist
{
  width: 140rpx;
  display: flex;
  flex-wrap: wrap;
  font-size: 10rpx;
}
.cateitem
{
  width: 70rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  cursor: pointer;
}
.arrow
{
  position: absolute;
  left: 60rpx;
  top: 225rpx;
  width: 20rpx;
  height: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 11rpx;
  background-color: #ffffff;
  z-index: 8;
  cursor: pointer;
}
.allarrow
{
  left: 130rpx;
}
.right
{
  padding: 20rpx;
  padding-left: 90rpx;
  box-sizing: border-box;
  padding-top: 0;
  position: relative;
  height: 100%;
  width: 100%;
}
.searchbar
{
  display: flex;
  align-items: center;
  position: relative;
  font-size: 10rpx;
  border-radius: 6rpx;
  overflow: hidden;
  width: 230rpx;
  height: 28rpx;
}
.searchbar input
{
  background-color: #f6f6f6;
  width: 180rpx;
  height: 28rpx;
  padding-left: 24rpx;
}
.searchbtn
{
  width: 50rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;  
  color: #ffffff;
  cursor: pointer;
}
.searchincon
{
  position: absolute;
  left: 8rpx;
  top: 9rpx;
}

.list
{
  margin-top: 10rpx;
  width: 100%;
  padding: 0 5rpx;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.jubenitem
{
  width: 285rpx;
  height: 150rpx;
  display: flex;
  align-items: center;
  padding: 10rpx;
  box-sizing: border-box;
  margin-bottom: 14rpx;
  border-radius: 10rpx;
  cursor: pointer;
}
.jubenimg
{
  width: 90rpx;
  height: 130rpx;
}
.iteminfo
{
  margin-left: 10rpx;
  height: 120rpx;
  width: 160rpx;
}
.iteminfo-title
{
  font-size: 12rpx;
  margin-left: 5rpx;
}
.iteminfo-tag
{
  width: 160rpx;
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
  height: 60rpx;
  overflow: hidden;
}
.itemtag
{
  height: 20rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  font-size: 9rpx;
  background-color: #4A619A;
  color: #ffffff;
  text-align: center;
  line-height: 20rpx;
  border-radius: 4rpx;
  margin: 5rpx;
}

.active
{
  background-color: #1D4ABD;
  color: #ffffff;
}


.iteminfo-mark
{
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  font-size: 10rpx;
  color: #999999;
  margin-left: 5rpx;
}
.markitem
{
  display: flex;
  align-items: center;
}
.markitem image
{
  width: 12rpx;
  height: 12rpx;
  margin-right: 5rpx;
}

.pageview
{
  /* margin-top: 20rpx; */
  position: absolute;
  bottom: 20rpx;
  left: 70rpx;
  width: 600rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pre,.next
{
  width: 70rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border:2rpx solid #f6f6f6 ;
  text-align: center;
  line-height: 40rpx;
  font-size: 16rpx;
  cursor: pointer;
}
.pagenum
{
  font-size: 16rpx;
  color: #333333;
  margin: 0 50rpx;
}
.pagenum text
{
  font-weight: 500;
  font-size: 18rpx;
}

.selectresult
{
  display: flex;
  margin-top: 20rpx;
  font-size: 10rpx;
}
.selecttag
{
  width: 540rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-left: 10rpx;
}
.itemtag1
{
  height: 20rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  font-size: 9rpx;
  background-color: rgba(246, 246, 246, 0.5);
  color: #333333;
  text-align: center;
  line-height: 20rpx;
  border-radius: 4rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}
.selecttitle
{
  height: 20rpx;
  line-height: 20rpx;
  color: #666666;
}

.popview
{
  background-color: #ffffff;
  border-radius: 10rpx;
  width: 300rpx;
  position: relative;
  overflow: hidden;
}
.popclose
{
  position: absolute;
  z-index: 5;
  right: 20rpx;
  top: 14rpx;
  cursor: pointer;
}
.poptitle
{
  width: 100%;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
}
.popcon
{
  padding: 20rpx;
  box-sizing: border-box;
}
.popname
{
}
.poptag
{
  display: flex;
  margin-top: 10rpx;
}
.poptags
{
  display: flex;
  flex-wrap: wrap;
  width: 210rpx;
}
.popprice
{
  display: flex;
  align-items: center;
}
.popprice input
{
  font-size: 10rpx;
  padding-left: 10rpx;
  width: 150rpx;
  border: 1rpx solid #dedede;
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 6rpx;
}
.popbtn
{
  width: 100rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 10rpx;
  color: #ffffff;
  border-radius: 15rpx;
  margin: 20rpx auto;
  margin-bottom: 0;
  cursor: pointer;
}

.radio
{
  /* transform:scale(0.5); */
  margin-right: 15rpx !important;
  font-size: 11rpx !important;
}


.nodata
{
  font-size: 12rpx;
  color: #999999;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
}


.nodata1
{
  font-size: 26rpx;
  color: #999999;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
}
/*  */
.versearchbar
{
  margin: 20rpx 30rpx;
  width: 690rpx;
  height: 68rpx;
  border-radius: 34rpx;
  position: relative;
}
.versearchbar input
{
  width: 526rpx;
  height: 100%;
  background-color: #ffffff;
  font-size: 26rpx;
  padding-left: 60rpx;
}
.versearchbtn
{
  width: 164rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 28rpx;
}
.versearchincon
{
  top: 18rpx;
  left: 15rpx;
}
.verbody
{
  background-color: transparent;
  margin: 0;
  width: 100%;
  position: relative;
}
.verleft
{
  background-color: #ffffff !important;
  width: 160rpx;
}

.vercatelist
{
  width: 160rpx;
}
.vercateitem
{
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  line-height: 80rpx;
}
.vercatescroll
{
  height: 100%;
}
.verlefttitle
{
  width: 160rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.verright
{
  padding-left: 180rpx;
  padding-top: 20rpx;
}
.verselecttag
{
  width: 400rpx;
}
.veritemtag
{
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  padding: 0 15rpx;
  border-radius: 5rpx;
  font-size: 18rpx;
  color: #ffffff;
  margin-right: 10rpx;
}
.verlist
{
  margin-top: 10rpx;
}
.verjubenitem
{
  background-color: #ffffff;
  width: 540rpx;
  height: 280rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}
.verjubenimg
{
  width: 164rpx;
  height: 220rpx;
  /* border-radius: 10rpx; */
}
.veriteminfo
{
  width: 320rpx;
  margin-left: 20rpx;
  height: 210rpx;
}
.veriteminfo-mark
{
  font-size: 24rpx;
  margin-top: 40rpx;
}
.veriteminfo-mark image
{
  width: 24rpx;
  height: 24rpx;
}
.veritemtag1
{
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 15rpx;
  box-sizing: border-box;
  font-size: 20rpx;
}
.veriteminfo-tag
{
  width: 320rpx;
  height: 85rpx;
}
.listscroll
{
  margin-top: 20rpx;
}

.verpopview
{
  width: 500rpx;
}
.verpoptitle
{
  height: 70rpx;
  line-height: 70rpx;
}
.verpoptags
{
  width: 320rpx;
  display: flex;
  flex-wrap: wrap;
}
.verpoptag
{
  margin-top: 20rpx;
}
.verpopprice input
{
  width: 280rpx;
  font-size: 24rpx;
}
.verpopbtn
{
  width: 160rpx;
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 27rpx;
  font-size: 24rpx;
}

.verradio
{
  /* transform:scale(0.5); */
  margin-right: 40rpx !important;
  font-size: 26rpx !important;
}
.unit
{
  color: #999999;
}